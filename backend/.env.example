# Copy this file to ".env" and fill in your real values.
# ".env" is gitignored — never commit real credentials.

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGO_URL=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=duitku

# Shared secret that locks the API. Leave EMPTY for local development.
# Before deploying publicly, set a long random string here AND set the same
# value as EXPO_PUBLIC_API_KEY in the frontend's .env, then rebuild the app.
API_KEY=
