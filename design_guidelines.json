  "testing": {
    "rules": [
      "All interactive elements MUST have a data-testid attribute.",
      "Convention: kebab-case, role-based.",
      "Examples: data-testid='fab-add-transaction', data-testid='tab-pengeluaran', data-testid='input-amount'"
    ]
  },
  "instructions_to_main_agent": [
    "Initialize React Native Expo without any web-only libraries (e.g., Shadcn or HTML elements).",
    "Use standard StyleSheet.create for styling to maintain performance and consistency.",
    "Implement navigation using @react-navigation/drawer for the Side Drawer and bottom tabs for main views.",
    "Build a custom Header component to achieve the required curved bottom corners (borderBottomLeftRadius/RightRadius: 24) and #4A8B7B background.",
    "Use lucide-react-native for all icons.",
    "For charts, use react-native-gifted-charts and react-native-svg for the Donut and Bar charts.",
    "Ensure the numeric keypad in the Add Transaction modal is custom or optimized for quick currency entry without decimal clutter.",
    "Format currency natively in Bahasa Indonesia format (Rp123.456). Use Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).",
    "Set Monday (Senin) as the start of the week for any period selector or date picker."
  ]
}